# Secrets — copy to .env (never commit .env)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional (Phase 1+)
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# API / frontend (Phase 6) — VITE_API_BASE_URL is for the Vercel build; local Vite uses the /api proxy
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ALLOW_VERCEL_ORIGINS=1
